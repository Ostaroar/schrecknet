{
  "source": "https://github.com/smeea/vdb/blob/master/frontend/src/utils/cardFilters.js + V5 cards.sqlite snapshot",
  "crypt": {
    "rest_query": "groups=6%2C7&discipline_requirements=dom%3Asuperior%2Cfor%3Aany&discipline_or=cel%3Asuperior%7Cobf%3Aany",
    "groups": [6, 7],
    "requirements": [
      { "code": "dom", "clicks": 2 },
      { "code": "for", "clicks": 1 }
    ],
    "or": [
      { "code": "cel", "superior": true },
      { "code": "obf", "superior": false }
    ],
    "expected_ids": [201735, 201782, 201751]
  },
  "crypt_metadata": {
    "rest_query": "sects=sabbat&votes=3",
    "sect": "Sabbat",
    "votes": 3,
    "expected_ids": [201733, 201741, 201735, 201760]
  },
  "library": {
    "rest_query": "disciplines=pot%2Cpre&discipline_logic=only",
    "disciplines": ["pot", "pre"],
    "logic": "Only",
    "expected_ids": [102308, 102316, 101008, 101772, 102346]
  },
  "library_capacity_requirement": {
    "rest_query": "capacity_requirement=6&capacity_requirement_mode=at_least",
    "mode": "at_least",
    "value": 6,
    "expected_ids": [101717]
  },
  "library_requirements": {
    "rest_query": "sect_requirements=anarch&title_requirements=baron",
    "sect": "Anarch",
    "title": "Baron",
    "expected_ids": [102218, 102246, 101324, 102230, 101631]
  }
}
